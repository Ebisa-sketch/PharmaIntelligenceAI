{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medicine",
  "description": "Validation schema for pharmaceutical product definitions",
  "type": "object",
  "required": [
    "medicine_id",
    "name",
    "generic_name",
    "atc_code",
    "dosage_form",
    "strength",
    "unit_of_measure",
    "therapeutic_class"
  ],
  "properties": {
    "medicine_id": {
      "type": "string",
      "pattern": "^MED-[A-Z0-9]{6,12}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "generic_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "brand_name": {
      "type": "string"
    },
    "atc_code": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{2}[A-Z][0-9]{2}$"
    },
    "ndc_code": {
      "type": "string"
    },
    "dosage_form": {
      "type": "string",
      "enum": ["Tablet", "Capsule", "Syrup", "Injection", "Ointment", "Suspension", "Inhaler", "Suppository"]
    },
    "strength": {
      "type": "string"
    },
    "unit_of_measure": {
      "type": "string",
      "enum": ["mg", "ml", "g", "mcg", "IU", "puffs"]
    },
    "therapeutic_class": {
      "type": "string"
    },
    "is_prescription_required": {
      "type": "boolean",
      "default": true
    },
    "storage_condition": {
      "type": "string",
      "enum": ["Room Temperature", "Refrigerated (2-8C)", "Frozen (< -15C)", "Controlled Room Temperature"]
    },
    "standard_pack_size": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
