# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key
API_V1_STR=/api/v1
PROJECT_NAME="PharmaIntelligence AI"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pharmaintelligence_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharmaintelligence_db

# Security & JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Redis & Celery (Future expansion)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

